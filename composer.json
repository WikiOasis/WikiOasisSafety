{
	"name": "wikioasis/wikioasis-safety",
	"type": "mediawiki-extension",
	"description": "A MediaWiki extension bridging TSPortal and safety",
	"homepage": "https://meta.wikioasis.org/wiki/Trust_and_Safety",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "WikiOasis Trust & Safety"
		}
	],
	"support": {
		"issues": "https://github.com/WikiOasis/WikiOasisSafety/issues",
		"wiki": "https://meta.wikioasis.org/wiki/Trust_and_Safety"
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "47.0.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf; if [ $? -eq 1 ]; then exit 0; fi"
		],
		"test": [
			"parallel-lint . --exclude node_modules --exclude vendor",
			"minus-x check .",
			"@phpunit"
		],
		"phpcs": "phpcs -sp --cache",
		"phpunit": "phpunit"
	},
	"config": {
		"prepend-autoloader": false,
		"optimize-autoloader": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
